# Copiez ce fichier en .env et renseignez les clés des fournisseurs que vous
# utilisez réellement. Une seule suffit si les trois agents partagent le même
# fournisseur (voir les variantes en fin de magi.yaml).
#
# Aucune clé n'est nécessaire avec `--backend simulated`.

# MELCHIOR-1 et l'orchestrateur, dans la configuration par défaut
ANTHROPIC_API_KEY=

# BALTHASAR-2
OPENAI_API_KEY=

# CASPER-3
GEMINI_API_KEY=

# Autres fournisseurs supportés par LiteLLM
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=

# --- Surcharges de configuration (prioritaires sur magi.yaml) ---------------
# MAGI_BACKEND=simulated
# MAGI_ROUNDS=2
# MAGI_MELCHIOR_MODEL=anthropic/claude-opus-5
# MAGI_BALTHASAR_MODEL=openai/gpt-4o
# MAGI_CASPER_MODEL=gemini/gemini-2.5-pro
# MAGI_ORCHESTRATOR_MODEL=anthropic/claude-sonnet-5
